<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/said_background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Administrator Console (Desktop / Tablet View)"
                android:textColor="@color/said_navy_text"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnAdminLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:backgroundTint="@android:color/holo_red_dark"/>
        </LinearLayout>

        <!-- Tablet Multi-Column Grid Layout -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Card 1: Requests Management -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Requests &amp; Areas"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/said_navy_text"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View all pending and expired requests mapped across serviced areas."
                        android:paddingBottom="16dp"/>

                    <Button
                        android:id="@+id/btnManageRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Requests"
                        android:backgroundTint="@color/said_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Scheduling & Notifications -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scheduling &amp; Notifications"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/said_navy_text"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Create, edit, or delete schedule lists and broadcast alerts."
                        android:paddingBottom="16dp"/>

                    <Button
                        android:id="@+id/btnManageScheduling"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Schedules"
                        android:backgroundTint="@color/said_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Outreach Outcomes -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Outreach Outcomes"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/said_navy_text"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Review summary flags, area reports, and visit entries."
                        android:paddingBottom="16dp"/>

                    <Button
                        android:id="@+id/btnOutcomesSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Outcomes"
                        android:backgroundTint="@color/said_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Admin Profile Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Admin Profile"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/said_navy_text"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Update your admin account credentials and password."
                        android:paddingBottom="16dp"/>

                    <Button
                        android:id="@+id/btnAdminProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:backgroundTint="@color/said_primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

    </LinearLayout>
</ScrollView>