<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/said_accent"
        android:contentDescription="Back"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Visit History"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvPetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Pet Name]"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvPetBreed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Breed] • [Gender]"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvVisitCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 visit(s)"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <!-- No History Message -->
    <TextView
        android:id="@+id/tvNoHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No visit records found for this pet"
        android:textSize="16sp"
        android:textColor="#999999"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"/>

    <!-- Visit History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVisitHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>