<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/said_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textColor="@color/said_navy_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp">

        <TextView
            android:id="@+id/textAdminName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: System Administrator"
            android:textSize="14sp"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/textAdminEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: admin@theloop.org"
            android:textSize="14sp"
            android:paddingBottom="20dp"/>

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:backgroundTint="@color/said_navy_text"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnDeleteProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Profile"
            android:backgroundTint="@android:color/holo_red_dark"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Out"
            android:backgroundTint="@android:color/darker_gray"/>

    </LinearLayout>

</LinearLayout>