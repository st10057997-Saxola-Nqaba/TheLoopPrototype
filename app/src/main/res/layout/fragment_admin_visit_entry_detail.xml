<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/said_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/said_accent"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Visit Entry Details"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/said_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Granular details of visit record"
                    android:textSize="12sp"
                    android:textColor="#666666" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPLETED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_status_fulfilled"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Visit Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Visit ID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Visit ID"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailVisitId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Visit ID]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Owner -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Owner Name]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />


                <!-- Outcome -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Outcome"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailOutcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Outcome]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Flags -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Flags"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailFlags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Flags]"
                    android:textSize="16sp"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="12dp" />

                <!-- Officer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Officer"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailOfficer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Officer Name]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Timestamp -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date &amp; Time"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailTimestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Date &amp; Time]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Notes -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notes"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Notes]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>