<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/said_background"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnBackFromOutcomes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:backgroundTint="@color/said_navy_text"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Outreach Outcomes: Summary of Flags"
        android:textColor="@color/said_navy_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Viewing flag summaries from all outreach initiatives over specified periods."
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp"
        android:paddingBottom="12dp"/>

    <!-- Scrollable container for outcome records -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/containerOutcomesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

</LinearLayout>