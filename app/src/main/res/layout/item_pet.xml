<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/said_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Pet Avatar -->
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ic_pet_avatar"
            android:gravity="center"
            android:text="🐾"
            android:textSize="24sp"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Pet Name]"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/said_navy_text"/>

            <TextView
                android:id="@+id/tvPetType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Type]"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvPetBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Breed]"
                android:textSize="12sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/tvPetGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Gender]"
                android:textSize="14sp"
                android:textColor="#666666"/>

        </LinearLayout>

        <!-- Sterilised Badge -->
        <TextView
            android:id="@+id/ivSterilised"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/said_primary"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            android:contentDescription="Sterilised"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="#666666"
            android:contentDescription="View Pet"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>