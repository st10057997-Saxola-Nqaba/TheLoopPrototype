<?xml version="1.0" encoding="utf-8"?>

<!--
Code Attribution

Fix: Resolved edge-to-edge enforcement hiding the back button on Android 15.
Added android:fitsSystemWindows="true" to the top container in owner-flow
layouts to properly manage top insets—the status bar was overlaying and
obscuring the back button.

References:
- Android Developers. (2026). Display content edge-to-edge in views.
  https://developer.android.com/develop/ui/views/layout/edge-to-edge
- Jamal, E. (2025). How to support edge-to-edge display in Android apps?
  ProAndroidDev. https://proandroiddev.com/how-to-support-edge-to-edge-display-in-android-apps-part-i-0ab1adf5986f
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>