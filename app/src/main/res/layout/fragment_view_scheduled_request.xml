<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/said_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar with Back Button -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarScheduleDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationContentDescription="Back"
            android:layout_marginBottom="4dp" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheduled Request"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/said_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View request details and take action"
                android:textSize="14sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCHEDULED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_status_scheduled"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Request Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Owner -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner: [Owner Name]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Pet -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pet"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPetInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pet: [Pet Name] ([Breed])"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequestDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Issue: [Request Description]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Severity -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Severity"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeverity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Severity]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Schedule Date -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Schedule Date"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScheduleDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scheduled For: [Schedule Date]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Area -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Area"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Area]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Owner Contact Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Information"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/said_accent"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvOwnerContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone: [Phone Number]"
                    android:textSize="16sp"
                    android:textColor="@color/said_accent" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateVisit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Visit Entry"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/said_primary"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateOwnerDetails"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update Owner Details"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/said_accent"
            android:backgroundTint="#E3F2FD"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>