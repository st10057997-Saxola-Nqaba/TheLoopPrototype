<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- 1. Login Screen (Entry point) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.theloopprototype.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_aht_home"
            app:destination="@id/ahtHomeFragment" />
        <action
            android:id="@+id/action_login_to_owner_home"
            app:destination="@id/ownerHomeFragment" />
    </fragment>

    <!-- 2. AHT Home (Scheduled Requests) -->
    <fragment
        android:id="@+id/ahtHomeFragment"
        android:name="com.example.theloopprototype.ui.aht.AhtHomeFragment"
        android:label="Scheduled Requests"
        tools:layout="@layout/fragment_aht_home" />

    <!-- 3. Pet Owner Home (My Pets) -->
   <!-- <fragment
        android:id="@+id/ownerHomeFragment"
        android:name="com.example.theloopprototype.ui.owner.OwnerHomeFragment"
        android:label="My Pets"
        tools:layout="@layout/fragment_owner_home" />-->
    <!--pet-owner home OV-->
    <fragment
        android:id="@+id/petOwnerHomeFragment"
        android:name="com.example.theloopprototype.ui.petowner.PetOwnerHomeFragment"
        android:label="My Pets"
        tools:layout="@layout/fragment_pet_owner_home">

        <action
            android:id="@+id/action_petOwnerHomeFragment_to_addPetFragment"
            app:destination="@id/addPetFragment"/>

        <action
            android:id="@+id/action_petOwnerHomeFragment_to_myRequestsFragment"
            app:destination="@id/myRequestsFragment"/>

        <action
            android:id="@+id/action_petOwnerHomeFragment_to_petOwnerProfileFragment"
            app:destination="@id/petOwnerProfileFragment"/>

        <action
            android:id="@+id/action_petOwnerHomeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/petOwnerHomeFragment"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_petOwnerHomeFragment_to_viewPetFragment"
            app:destination="@id/viewPetFragment"/>

    </fragment>

    <fragment
        android:id="@+id/addPetFragment"
        android:name="com.example.theloopprototype.ui.petowner.AddPetFragment"
        android:label="Add Pet"
        tools:layout="@layout/fragment_add_pet"/>

    <fragment
        android:id="@+id/viewPetFragment"
        android:name="com.example.theloopprototype.ui.petowner.ViewPetFragment"
        android:label="View Pet"
        tools:layout="@layout/fragment_view_pet">

        <argument
            android:name="petId"
            app:argType="string"/>

        <action
            android:id="@+id/action_viewPetFragment_to_requestVisitFragment"
            app:destination="@id/requestVisitFragment"/>

        <action
            android:id="@+id/action_viewPetFragment_to_viewVisitHistoryFragment"
            app:destination="@id/viewVisitHistoryFragment"/>

    </fragment>

    <fragment
        android:id="@+id/myRequestsFragment"
        android:name="com.example.theloopprototype.ui.petowner.MyRequestsFragment"
        android:label="My Requests"
        tools:layout="@layout/fragment_my_requests">

        <action
            android:id="@+id/action_myRequestsFragment_to_requestDetailsFragment"
            app:destination="@id/requestDetailsFragment"/>

        <action
            android:id="@+id/action_myRequestsFragment_to_addPetFragment"
            app:destination="@id/addPetFragment"/>

    </fragment>

    <fragment
        android:id="@+id/requestDetailsFragment"
        android:name="com.example.theloopprototype.ui.petowner.RequestDetailsFragment"
        android:label="Request Details"
        tools:layout="@layout/fragment_request_details">

        <argument
            android:name="requestId"
            app:argType="string"/>

        <action
            android:id="@+id/action_requestDetailsFragment_to_viewVisitHistoryFragment"
            app:destination="@id/viewVisitHistoryFragment"/>

    </fragment>

    <fragment
        android:id="@+id/viewVisitHistoryFragment"
        android:name="com.example.theloopprototype.ui.petowner.ViewVisitHistoryFragment"
        android:label="Visit History"
        tools:layout="@layout/fragment_view_visit_history">

        <argument
            android:name="petId"
            app:argType="string"/>

    </fragment>

    <fragment
        android:id="@+id/requestVisitFragment"
        android:name="com.example.theloopprototype.ui.petowner.RequestVisitFragment"
        android:label="Request Visit"
        tools:layout="@layout/fragment_request_visit">

        <argument
            android:name="petId"
            app:argType="string"/>

    </fragment>

    <fragment
        android:id="@+id/petOwnerProfileFragment"
        android:name="com.example.theloopprototype.ui.petowner.PetOwnerProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_pet_owner_profile">

        <action
            android:id="@+id/action_petOwnerProfileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/petOwnerHomeFragment"
            app:popUpToInclusive="true"/>

    </fragment>



</navigation>